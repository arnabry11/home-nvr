# Copy to .env and fill in. Never commit .env.

# RTSP credentials shared by the cameras (used in go2rtc/go2rtc.yaml).
CAMERA_USER=
CAMERA_PASSWORD=

# Tailscale auth key, only needed for the sidecar's first start:
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# The UI is served at https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=nvr

# Where MediaMTX writes recordings, and how long it keeps them.
RECORDINGS_DIR=./recordings
RECORD_RETENTION=6d
